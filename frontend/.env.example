# Where the backend runs, without "/api" and without a trailing slash.
# Leave empty on your own computer: Vite forwards /api to http://localhost:5000.
# On Vercel, set it under Project > Settings > Environment Variables, e.g.
#   VITE_API_URL=https://your-backend.vercel.app
# It is read when the site is built, so redeploy after changing it.
VITE_API_URL=
