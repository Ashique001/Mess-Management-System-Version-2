# Copy this file to ".env" and fill in your own values. Never commit ".env".
# On Vercel, add the same names under Project > Settings > Environment Variables.

# MongoDB Atlas > Database > Connect > Drivers. Add a database name before the "?".
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mess_meal?retryWrites=true&w=majority
MONGODB_URI=

# Signs login tokens. At least 32 random characters. Create one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts.
JWT_EXPIRES_IN=7d

# Websites allowed to call this API, comma separated, without a trailing slash.
CORS_ORIGIN=http://localhost:5173

# The platform owner. Created on the first start if no super admin exists yet.
# Use a strong password (8 characters or more). To reset it later, change the
# value here and run: npm run create-superadmin
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# false: a newly registered mess must be approved by the super admin first.
SIGNUP_AUTO_APPROVE=false

# Local development port. Vercel ignores it.
PORT=5000
